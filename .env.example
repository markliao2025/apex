# =============================================================================
# Apex production/development overrides.
# The default synthetic demo does not require this file.
# =============================================================================

# ---- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=apex
POSTGRES_PASSWORD=
POSTGRES_DB=apex_rigor
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---- JWT / Auth --------------------------------------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Runtime -----------------------------------------------------------------
APP_ENV=development
DEMO_MODE=false
CONJUNCTION_DEMO_ENABLED=false
LLM_PROVIDER=none
ALLOW_NETWORK_SEED=false

# ---- Optional LLM (not used by Phase 0 demo) ---------------------------------
OPENAI_API_KEY=

# ---- API base URLs -----------------------------------------------------------
API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
